name: CD

on:
  pull_request:
    branches: ["main"]
  push:
    branches: ["main"]

jobs:
  delivery:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar código
        uses: actions/checkout@v4

      - name: Verificar arquivos do projeto
        run: |
          test -f index.html
          test -f style.css
          test -f script.js
          test -f Dockerfile

      - name: Validar Dockerfile
        run: |
          grep -q "FROM nginx:alpine" Dockerfile
          grep -q "COPY . /usr/share/nginx/html" Dockerfile
