name: CI

on:
  pull_request:
    branches: ["main"]
  push:
    branches: ["main"]

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar código
        uses: actions/checkout@v4

      - name: Verificar arquivos
        run: |
          test -f index.html
          test -f style.css
          test -f script.js

      - name: Verificar referências
        run: |
          grep -q 'style.css' index.html
          grep -q 'script.js' index.html
